# =============================================================================
# Pharma Safety Intake Tracker — example env (copy to .env and fill secrets)
# Restart uvicorn after any change. Never commit real .env secrets.
# =============================================================================

# --- App / API ---
APP_NAME=Pharma Safety Intake Tracker
APP_ENV=development
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: set APP_ENV=production and a long random SECRET_KEY.
# Demo users (admin/Admin@123 etc.) are skipped in production unless:
SEED_DEMO_USERS=false
# Training allows the same user to request + approve close. Set false for SoD in prod:
ALLOW_SELF_APPROVE=true
MAX_UPLOAD_BYTES=15728640

# --- Multi-SQLite ---
CORE_DB_URL=sqlite:///./data/core.db
AUDIT_DB_URL=sqlite:///./data/audit.db
RAG_DB_URL=sqlite:///./data/rag.db
OBS_DB_URL=sqlite:///./data/observability.db

# --- Embeddings + vector store ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# On-disk Hub cache (download once). Default: ./data/embedding_models
# Prefer project data/ over OS temp so weights survive reboot / uvicorn --reload.
EMBEDDING_CACHE_DIR=./data/embedding_models
VECTOR_STORE_PROVIDER=chromadb

# =============================================================================
# LLM routing: Groq primary for all agent/RAG roles; Google only on total Groq fail
# =============================================================================
LLM_PROVIDER=groq
LLM_MODEL_NAME=openai/gpt-oss-120b
LLM_CHEAP_MODEL=openai/gpt-oss-20b
LLM_QUALITY_MODEL=openai/gpt-oss-120b

# Groq primary + comma-separated rotation pool
GROQ_API_KEY=
GROQ_API_KEYS=

# Google fallback
GOOGLE_API_KEY=
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=google
LLM_FALLBACK_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Cheap roles
LLM_ROUTER_PROVIDER=groq
LLM_ROUTER_MODEL=openai/gpt-oss-20b
LLM_ROUTER_API_KEY=

LLM_SOCIAL_PROVIDER=groq
LLM_SOCIAL_MODEL=openai/gpt-oss-20b
LLM_SOCIAL_API_KEY=

LLM_QUERY_ENHANCER_PROVIDER=groq
LLM_QUERY_ENHANCER_MODEL=openai/gpt-oss-20b
LLM_QUERY_ENHANCER_API_KEY=

LLM_QUERY_REWRITE_PROVIDER=groq
LLM_QUERY_REWRITE_MODEL=openai/gpt-oss-20b
LLM_QUERY_REWRITE_API_KEY=

LLM_CHUNKING_PROVIDER=groq
LLM_CHUNKING_MODEL=openai/gpt-oss-20b
LLM_CHUNKING_API_KEY=

# Quality roles
LLM_RESPONSE_PROVIDER=groq
LLM_RESPONSE_MODEL=openai/gpt-oss-120b
LLM_RESPONSE_API_KEY=

LLM_RAG_PROVIDER=groq
LLM_RAG_MODEL=openai/gpt-oss-120b
LLM_RAG_API_KEY=

# Tracing: off | custom | langfuse | both
TRACING_MODE=both
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
FAISS_DIR=./data/faiss
CHROMA_DIR=./data/chroma

DEFAULT_CHUNK_STRATEGY=recursive
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64

RAG_QUERY_ENHANCER_ENABLED=true
RAG_MULTI_QUERY_ENABLED=true
RAG_MULTI_QUERY_COUNT=3

RERANKER_PROVIDER=auto
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_SCORE_THRESHOLD=0.40
RERANK_CANDIDATE_LIMIT=50

# Agent tools: local (tools.py) or mcp (FastMCP mcp_server/server.py)
# UI under Agent → Configuration can override at runtime (process restart clears override).
AGENT_TOOL_BACKEND=local
# inprocess = Client(mcp) in the API process; http = Client(AGENT_MCP_URL)
AGENT_MCP_TRANSPORT=inprocess
AGENT_MCP_URL=http://127.0.0.1:8765/mcp
